# ==============================================================================
# 1st Engine (main branch) - Build Configuration (pmakefile)
# ==============================================================================
# Usage:
#   pmake          - Build the project (default)
#   pmake build    - Build the project
#   pmake run      - Build and run the executable
#   pmake clean    - Remove all build artifacts
#   pmake rebuild  - Clean and rebuild from scratch
# ==============================================================================

# --- Compiler Settings --------------------------------------------------------
CXX       := g++
CXXFLAGS  := -std=c++20 -Wall -Wextra -Wpedantic -g
LDFLAGS   := -lglew32 -lglfw3 -lopengl32 -lgdi32

# --- Project Structure --------------------------------------------------------
SRC_DIR   := openGl/application
INC_DIR   := openGl/dependance
BUILD_DIR := build
TARGET    := $(BUILD_DIR)/engine.exe

# --- Source Files -------------------------------------------------------------
SOURCES   := $(wildcard $(SRC_DIR)/*.cpp)
OBJECTS   := $(patsubst $(SRC_DIR)/%.cpp,$(BUILD_DIR)/%.o,$(SOURCES))

# ==============================================================================
# Build Targets
# ==============================================================================

.PHONY: all
all: build

.PHONY: build
build: $(TARGET)
	@echo.
	@echo [BUILD] Build complete: $(TARGET)

# Link
$(TARGET): $(OBJECTS)
	@echo [LINK] $@
	$(CXX) $(OBJECTS) -o $@ $(LDFLAGS)

# Compile each .cpp -> .o (includes both src dir and dependance dir for headers)
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cpp
	@if not exist "$(BUILD_DIR)" mkdir "$(BUILD_DIR)"
	@echo [CXX]  $<
	$(CXX) $(CXXFLAGS) -I$(INC_DIR) -c $< -o $@

.PHONY: run
run: build
	@echo.
	@echo [RUN] Running $(TARGET)...
	@echo ----------------------------------------
	@$(TARGET)

.PHONY: clean
clean:
	@echo [CLEAN] Removing build artifacts...
	@if exist "$(BUILD_DIR)" rmdir /s /q "$(BUILD_DIR)"
	@echo [CLEAN] Done.

.PHONY: rebuild
rebuild: clean build

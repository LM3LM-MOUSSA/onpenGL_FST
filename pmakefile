# ==============================================================================
# 1st Engine - Build Configuration (pmakefile)
# ==============================================================================
# Usage:
#   pmake          - Build the project (default)
#   pmake build    - Build the project
#   pmake run      - Build and run the executable
#   pmake clean    - Remove all build artifacts
#   pmake rebuild  - Clean and rebuild from scratch
# ==============================================================================

# --- Compiler Settings --------------------------------------------------------
CXX       := g++
CXXFLAGS  := -std=c++20 -Wall -Wextra -Wpedantic -g
LDFLAGS   := -lglew32 -lglfw3 -lopengl32 -lgdi32

# --- Project Structure --------------------------------------------------------
SRC_DIR   := engine
BUILD_DIR := build
TARGET    := $(BUILD_DIR)/engine.exe

# --- Source Files -------------------------------------------------------------
# Find all .cpp files in the source directory
SOURCES   := $(wildcard $(SRC_DIR)/*.cpp)
# Generate corresponding .o file paths in the build directory
OBJECTS   := $(patsubst $(SRC_DIR)/%.cpp,$(BUILD_DIR)/%.o,$(SOURCES))

# ==============================================================================
# Build Targets
# ==============================================================================

# Default target
.PHONY: all
all: build

# Build the project
.PHONY: build
build: $(TARGET)
	@echo.
	@echo [BUILD] Build complete: $(TARGET)

# Link object files into the final executable
$(TARGET): $(OBJECTS)
	@echo [LINK] $@
	$(CXX) $(OBJECTS) -o $@ $(LDFLAGS)

# Compile each .cpp file into a .o file
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cpp
	@if not exist "$(BUILD_DIR)" mkdir "$(BUILD_DIR)"
	@echo [CXX]  $<
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Run the executable (builds first if needed)
.PHONY: run
run: build
	@echo.
	@echo [RUN] Running $(TARGET)...
	@echo ----------------------------------------
	@$(TARGET)

# Remove all build artifacts
.PHONY: clean
clean:
	@echo [CLEAN] Removing build artifacts...
	@if exist "$(BUILD_DIR)" rmdir /s /q "$(BUILD_DIR)"
	@echo [CLEAN] Done.

# Clean and rebuild
.PHONY: rebuild
rebuild: clean build
